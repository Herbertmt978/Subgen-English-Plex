+// Classify the leading audio, not a later language elsewhere in the 30s window.
+static int subgen_leading_language(whisper_context * ctx, whisper_state * state,
+                                  int offset_ms, int n_threads, float * probs) {
+    const int start = offset_ms / 10;
+    const auto & source = state->mel;
+    if (start < 0 || start >= source.n_len_org) return -2;
+    whisper_mel sample;
+    sample.n_len = sample.n_len_org = std::min(500, source.n_len_org - start);
+    sample.n_mel = source.n_mel;
+    sample.data.resize(sample.n_len * sample.n_mel);
+    for (int channel = 0; channel < sample.n_mel; ++channel) {
+        std::copy_n(source.data.begin() + channel * source.n_len + start,
+                    sample.n_len, sample.data.begin() + channel * sample.n_len);
+    }
+    std::swap(state->mel, sample);
+    struct restore_mel {
+        whisper_state * state;
+        whisper_mel & saved;
+        ~restore_mel() { std::swap(state->mel, saved); }
+    } restore{state, sample};
+    return whisper_lang_auto_detect_with_state(ctx, state, 0, n_threads, probs);
+}
