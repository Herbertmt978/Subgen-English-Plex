# Required: host paths and the folders Subgen should scan inside the container.
MEDIA_ROOT=/srv/media
SUBGEN_MODEL_PATH=./models
SUBGEN_STATE_DIR=./monitor
TRANSCRIBE_FOLDERS=/media/Movies|/media/TV
SKIP_STARTUP_SCAN=False
SKIP_MARKED_FAILED_FILES=true

# Packaged profiles default to the current release tag. Leave blank unless you
# are deliberately testing another release tag or immutable digest.
SUBGEN_IMAGE=

# Match the Linux account that owns your media files.
PUID=1000
PGID=1000

# Public v0.5 base profiles use conservative missing-evidence fallback and need
# no host artifacts. Exact/canonical deployments add the supplied ModelEnvelope
# overlay, which mounts this owner-only parent and both leaves read-only:
# /var/lib/subgen/model-envelopes/v1
# /var/lib/subgen/model-envelopes/v1/catalog.json
# /var/lib/subgen/model-envelopes/v1/image-identity.json
MODEL_ENVELOPE_CATALOG=/opt/subgen/model-envelopes/catalog.json
MODEL_ENVELOPE_IDENTITY=/opt/subgen/model-envelopes/image-identity.json
WHISPER_MODEL=auto
SEGMENTATION_ENABLED=True
SEGMENTATION_CHUNK_MINUTES=auto
MEMORY_PRESSURE_YIELD=True
MEMORY_PRESSURE_RESERVE_GIB=auto
GPU_MEMORY_RESERVE_GIB=auto
CANONICAL_SHARED_CUDA=False
WHISPER_THREADS=4
SUBGEN_CPU_LIMIT=4.0
SUBGEN_MEMORY_LIMIT=10g
# Leave blank so the selected Compose profile supplies CPU 60s or GPU 300s.
MODEL_CLEANUP_DELAY=

# Loopback is safest. Set this to the host's private LAN IP only when another
# machine (for example Plex) must reach Subgen.
SUBGEN_BIND_ADDRESS=127.0.0.1

# Optional protection for compute-heavy HTTP endpoints. Generate a value with:
# openssl rand -hex 32
SUBGEN_API_KEY=

# Optional Plex webhook integration. Folder monitoring works without these.
PLEX_SERVER=
PLEX_TOKEN=
USE_PATH_MAPPING=False
PATH_MAPPING_FROM=
PATH_MAPPING_TO=

# For NVIDIA, start with docker-compose.gpu.yml. Generic VRAM tiers are
# fallback ceilings only; exact packaged-runtime ModelEnvelope evidence is
# authoritative. A canonical shared GPU must set CANONICAL_SHARED_CUDA=True
# and a positive audited GPU_MEMORY_RESERVE_GIB. Do not infer that reserve from
# total VRAM or a single idle reading.
