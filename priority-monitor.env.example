# The host writer and container reader must name the same file. The Compose
# priority-pressure overlay mounts its parent directory read-only.
FRIGATE_PRIORITY_SIGNAL_FILE=/run/subgen-priority/pressure.json

# Only exact literal-loopback HTTP origins are accepted. Ollama monitoring is
# optional and disabled when OLLAMA_PRIORITY_ORIGIN is unset or blank.
FRIGATE_PRIORITY_ORIGIN=http://127.0.0.1:5000
# OLLAMA_PRIORITY_ORIGIN=http://127.0.0.1:11434

# Required private inputs. The policy parent must be owned by the service user
# with mode 0700; the canonical policy itself must be mode 0600.
FRIGATE_PRIORITY_POLICY_FILE=/var/lib/subgen-priority/private/frigate-priority-policy.json
FRIGATE_CONFIG_FILE=/etc/frigate/config.yml
# SHA-256 of the exact canonical private policy bytes. Never commit the value.
FRIGATE_PRIORITY_POLICY_SHA256=
